<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER_LEFT" minHeight="-Infinity" minWidth="-Infinity" prefHeight="400.0" prefWidth="400.0" spacing="10.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="fi.jyu.ohj2.ipetresx.todo.controller.MainController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
   <TableView fx:id="taskTable" prefHeight="200.0" prefWidth="200.0" VBox.vgrow="ALWAYS" />
   <HBox prefHeight="26.0" prefWidth="360.0" VBox.vgrow="NEVER">
      <children>
         <TextField fx:id="newTaskName" HBox.hgrow="ALWAYS" />
          <Button fx:id="addNewTaskButton" text="Add Task" wrapText="true" HBox.hgrow="NEVER" />
      </children>
   </HBox>
   <Button fx:id="deleteTaskButton" prefHeight="26.0" prefWidth="119.0" text="Delete Task" wrapText="true" />
</VBox>
